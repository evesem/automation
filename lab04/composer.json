{
  "name": "evesem/jenkins-php-lab",
  "description": "Учебный PHP-проект для CI в Jenkins",
  "type": "project",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Lab04\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Lab04\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
