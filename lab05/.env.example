# Скопируйте этот файл в lab05/.env и замените значения на свои публичные ключи.
# lab05/.env и lab05/secrets/* (кроме скриптов) не должны попадать в Git.

# Публичный ключ для входа Jenkins Controller -> ssh-agent (PHP-агент)
JENKINS_AGENT_SSH_PUBKEY=ssh-ed25519 AAAA_REPLACE_ME jenkins-php

# Публичный ключ для входа Jenkins Controller -> ansible-agent
JENKINS_ANSIBLE_AGENT_SSH_PUBKEY=ssh-ed25519 AAAA_REPLACE_ME jenkins-ansible

# Публичный ключ ansible-agent -> test-server (пользователь ansible)
ANSIBLE_PUBLIC_KEY=ssh-ed25519 AAAA_REPLACE_ME ansible-to-test-server

# Приватный ключ ansible-agent -> test-server (монтируется в контейнер как secret)
ANSIBLE_PRIVATE_KEY_PATH=./secrets/id_ed25519_ansible
